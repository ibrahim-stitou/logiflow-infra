# Configuration de la stack LogiFlow (/opt/logiflow/.env sur le serveur).
#
# En production, ce fichier est GÉNÉRÉ par Ansible à partir de Terraform (domaines, images) et
# d'AWS SSM Parameter Store (secrets) : ne pas l'éditer à la main sur le serveur.
# En local (make local-up), copier en .env et compléter.
# Générer un secret : openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# --- Domaines (HTTPS automatique) ---
# Sans nom de domaine : sslip.io, ex. app.13-38-1-2.sslip.io (IP publique avec des tirets).
# En local : app.localhost et auth.localhost (certificat interne de Caddy).
APP_DOMAIN=app.localhost
AUTH_DOMAIN=auth.localhost

# --- Images (publiées sur GHCR par la CI de chaque dépôt) ---
BACKEND_IMAGE=ghcr.io/ibrahim-stitou/logiflow-backend:latest
AI_IMAGE=ghcr.io/ibrahim-stitou/logiflow-ai-service:latest
FRONTEND_IMAGE=ghcr.io/oussamazouaine/logiflow-frontend:latest
KEYCLOAK_IMAGE=ghcr.io/ibrahim-stitou/logiflow-keycloak:latest
POSTGRES_IMAGE=ghcr.io/ibrahim-stitou/logiflow-postgres:latest

# --- Secrets (SSM Parameter Store /logiflow/<env>/... en production) ---
DB_PASSWORD=
AI_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Clé Spring -> service IA, et clé service IA -> Spring (outils du copilote) : distinctes.
AI_INTERNAL_API_KEY=
AI_CALLBACK_API_KEY=
# Clé du fournisseur LLM (Groq : https://console.groq.com/keys). Vide : textes par gabarit.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- Données de démonstration ---
# true : jeu de démo (flotte, dossiers, maintenance…) et 6 comptes Keycloak (un par rôle).
# Ne s'applique qu'à une base neuve pour les données métier.
DEMO_DATA=true
DEMO_USERS_PASSWORD=
# Dérivé de DEMO_DATA par Ansible ; en local, garder la ligne correspondante :
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/migration/seed
# FLYWAY_LOCATIONS=classpath:db/migration

# --- Options ---
# true : le backend exige une preuve de second facteur (OTP) dans les jetons.
MFA_REQUIRED=false
# Swagger UI et /v3/api-docs publiés sur APP_DOMAIN.
API_DOCS_ENABLED=true
# Analyse de maintenance prédictive planifiée (heure de Paris), quand le serveur est allumé.
AI_MAINTENANCE_CRON=0 30 8 * * MON-FRI
