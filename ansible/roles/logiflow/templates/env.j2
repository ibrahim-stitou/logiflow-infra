# {{ ansible_managed }}
# Généré par Ansible (rôle logiflow) depuis SSM Parameter Store {{ logiflow_prefixe_ssm }} :
# ne pas modifier sur le serveur, les changements seraient écrasés au prochain `make configure`.
{% set demo = logiflow_config['demo-data'] | default('false') | bool %}

# --- Domaines ---
APP_DOMAIN={{ logiflow_config['app-domain'] }}
AUTH_DOMAIN={{ logiflow_config['auth-domain'] }}

# --- Images ---
BACKEND_IMAGE={{ logiflow_images.backend }}
AI_IMAGE={{ logiflow_images.ai }}
FRONTEND_IMAGE={{ logiflow_images.frontend }}
KEYCLOAK_IMAGE={{ logiflow_images.keycloak }}
POSTGRES_IMAGE={{ logiflow_images.postgres }}

# --- Secrets ---
DB_PASSWORD={{ logiflow_secrets['db-password'] }}
AI_DB_PASSWORD={{ logiflow_secrets['ai-db-password'] }}
KEYCLOAK_DB_PASSWORD={{ logiflow_secrets['keycloak-db-password'] }}
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD={{ logiflow_secrets['keycloak-admin-password'] }}
AI_INTERNAL_API_KEY={{ logiflow_secrets['ai-internal-api-key'] }}
AI_CALLBACK_API_KEY={{ logiflow_secrets['ai-callback-api-key'] }}
LLM_API_KEY={{ '' if logiflow_secrets['llm-api-key'] == 'A_RENSEIGNER' else logiflow_secrets['llm-api-key'] }}
LLM_MODEL={{ logiflow_llm_modele }}

# --- Données de démonstration ---
DEMO_DATA={{ 'true' if demo else 'false' }}
DEMO_USERS_PASSWORD={{ logiflow_secrets['demo-users-password'] }}
FLYWAY_LOCATIONS={{ 'classpath:db/migration,classpath:db/migration/seed' if demo else 'classpath:db/migration' }}

# --- Options ---
MFA_REQUIRED={{ logiflow_config['mfa-required'] | default('false') }}
API_DOCS_ENABLED=true
AI_MAINTENANCE_CRON=0 30 8 * * MON-FRI

# --- Sauvegardes ---
BACKUP_BUCKET={{ logiflow_config['bucket-sauvegardes'] }}
