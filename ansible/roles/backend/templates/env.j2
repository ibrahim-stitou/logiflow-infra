# Généré par Ansible (roles/backend) à chaque déploiement — ne jamais éditer à la main sur
# l'instance, les changements seraient écrasés au prochain run.

POSTGRES_DB=logiflow
POSTGRES_USER=logiflow
POSTGRES_PASSWORD={{ backend_db_password }}

SPRING_PROFILES_ACTIVE=local
# "local" (mode permissif, pas de vérification JWT) tant qu'aucun IdP (Keycloak/OIDC) n'est
# provisionné dans cette infra — voir docs/architecture.md, "Points à vérifier". À remplacer par
# "dev" + OAUTH2_ISSUER_URI/OAUTH2_JWK_SET_URI dès qu'un lot ultérieur ajoute l'IdP.
SERVER_PORT={{ host_port }}

DB_HOST=postgres
DB_PORT=5432
DB_NAME=logiflow
DB_USER=logiflow
DB_PASSWORD={{ backend_db_password }}

CORS_ALLOWED_ORIGINS=http://{{ hostvars[groups['role_frontend'][0]]['public_ip_address'] }}
ACTUATOR_EXPOSE=health,info,metrics,prometheus,modulith

AI_SERVICE_BASE_URL=http://{{ hostvars[groups['role_ai'][0]]['private_ip_address'] }}:{{ hostvars[groups['role_ai'][0]]['host_port'] | default(8000) }}
AI_SERVICE_API_KEY={{ backend_internal_api_key }}
AI_SERVICE_CONNECT_TIMEOUT=2s
AI_SERVICE_READ_TIMEOUT=8s
