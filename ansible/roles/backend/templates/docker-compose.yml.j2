name: logiflow

services:
  postgres:
    # Image custom (PostGIS + pgvector), publiée par la CI de logiflow-backend à partir de
    # docker/postgres/Dockerfile — l'image officielle postgis/postgis ne suffit pas (pas de
    # pgvector), voir ce Dockerfile pour le détail.
    image: {{ postgres_image }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - logiflow-postgres-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5

  app:
    image: {{ docker_image }}
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    env_file: .env
    ports:
      - "{{ host_port }}:{{ container_port }}"

volumes:
  logiflow-postgres-data:
